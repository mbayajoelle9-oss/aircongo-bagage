# Copiez ce fichier en .env pour travailler en local. Ne le publiez jamais sur GitHub.
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/aircongo?retryWrites=true&w=majority
# Chaîne aléatoire d'au moins 32 caractères, qui signe les sessions. Ne la partagez jamais.
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-32-caracteres-ou-plus
# Compte administrateur créé au premier démarrage (mot de passe de 10 caractères minimum)
ADMIN_EMAIL=admin@aquilanexus.tech
ADMIN_PASSWORD=changez-moi-svp-2026
ADMIN_NAME=Administrateur
# Adresse(s) du site web, séparées par des virgules (sans / final)
FRONTEND_URL=http://localhost:5500
# true = charge les données fictives au premier démarrage et active le bouton « Réinitialiser la démo »
SEED_DEMO=true
PORT=3000
