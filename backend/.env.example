# Copiez ce fichier en .env pour travailler en local. Ne le publiez jamais sur GitHub.
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/aircongo?retryWrites=true&w=majority
AGENT_KEY=changez-moi-agent-123456
ADMIN_KEY=changez-moi-admin-654321
# Adresse(s) du site web, séparées par des virgules (sans / final)
FRONTEND_URL=http://localhost:5500
# true = charge les données fictives au premier démarrage et active le bouton « Réinitialiser la démo »
SEED_DEMO=true
PORT=3000
